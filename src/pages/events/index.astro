---
import Layout from '../../layouts/Layout.astro';
import { events } from '../../data/events.js';

const activeEvents = events.filter((event) => event.status === 'active');
const archivedEvents = events.filter((event) => event.status === 'archived');
---
<Layout title="Events archive" description="Browse active and past WP Kerala community frame collections.">
  <section class="archive-page page-shell">
    <div class="archive-intro">
      <p class="eyebrow">The community library</p>
      <h1>Every event gets a frame.</h1>
      <p>Choose a current event to create something new, or revisit a frame from an earlier WP Kerala gathering.</p>
    </div>

    {activeEvents.length > 0 && (
      <section class="archive-group" aria-labelledby="active-events">
        <div class="group-heading">
          <div>
            <p class="eyebrow">Live now</p>
            <h2 id="active-events">Active events</h2>
          </div>
          <span class="group-count">{activeEvents.length} event{activeEvents.length === 1 ? '' : 's'}</span>
        </div>
        <div class="event-grid">
          {activeEvents.map((event) => (
            <a class="event-card event-card-active" href={`/events/${event.slug}/`}>
              <div class="event-card-art">
                <img src={event.frames[0].src} alt="" loading="lazy" />
                <span class="status-pill">Active</span>
              </div>
              <div class="event-card-copy">
                <p class="eyebrow">{event.dateLabel}</p>
                <h3>{event.title}</h3>
                <p>{event.venue}</p>
                <span class="text-link">Create your frame <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {archivedEvents.length > 0 && (
      <section class="archive-group" aria-labelledby="past-events">
        <div class="group-heading">
          <div>
            <p class="eyebrow">From the archive</p>
            <h2 id="past-events">Past events</h2>
          </div>
          <span class="group-count">{archivedEvents.length} event{archivedEvents.length === 1 ? '' : 's'}</span>
        </div>
        <div class="event-grid">
          {archivedEvents.map((event) => (
            <a class="event-card" href={`/events/${event.slug}/`}>
              <div class="event-card-art event-card-art-muted">
                <img src={event.frames[0].src} alt="" loading="lazy" />
                <span class="status-pill status-pill-muted">Past event</span>
              </div>
              <div class="event-card-copy">
                <p class="eyebrow">{event.dateLabel}</p>
                <h3>{event.title}</h3>
                <p>{event.venue}</p>
                <span class="text-link">View frames <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </section>
</Layout>
